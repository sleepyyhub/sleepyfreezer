{
  "name": "clovyre-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Clovyre MCP - a cloud bridge between a live Roblox client and remote MCP agents.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "^8.21.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.25",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
