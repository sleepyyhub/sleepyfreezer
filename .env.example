# Clovyre MCP environment.
# Copy to .env.local for development. Never commit a filled-in copy.

# Runtime mode. Render sets this to production.
NODE_ENV=development

# Port to bind. Render supplies this; locally it defaults to 3000.
PORT=3000

# Canonical public origin, used to build the loadstring and the MCP endpoint.
# Leave unset to derive it from the incoming request's forwarded host.
PUBLIC_BASE_URL=

# Salt for hashing client addresses in the audit trail.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# HMAC key for credential digests. Generate the same way as SESSION_SECRET.
# If either secret is unset, an ephemeral one is generated at boot and every
# session is invalidated on restart.
TOKEN_HASH_SECRET=

# Session lifetime in minutes (1-1440).
SESSION_TTL_MINUTES=60

# How long an owner-granted privileged capability lasts before expiring (1-120).
PRIVILEGE_TTL_MINUTES=15

# Maximum size of a single WebSocket frame, in bytes.
MAX_WS_PAYLOAD_BYTES=524288

# Upper bound on any single command timeout, in milliseconds.
MAX_COMMAND_TIMEOUT_MS=30000

# Upper bound on returned script source, in bytes.
MAX_SCRIPT_SOURCE_BYTES=262144

# Deployment kill switches for the privileged tool families.
# Setting either to false hides those tools regardless of any owner grant.
ENABLE_EXECUTE_LUAU_FEATURE=true
ENABLE_MUTATION_TOOLS_FEATURE=true

# Concurrent session ceiling.
MAX_SESSIONS=500

# NOTE: Clovyre needs no database and no Redis in this single-instance
# configuration, so there is deliberately no DATABASE_URL or REDIS_URL here.
# Deployment credentials (Render API keys, GitHub tokens) are never read by the
# application and must never appear in this file.
