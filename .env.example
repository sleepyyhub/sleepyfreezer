# Clovyre MCP environment.
# Copy to .env.local for development. Never commit a filled-in copy.

# Runtime mode. Render sets this to production.
NODE_ENV=development

# Port to bind. Render supplies this; locally it defaults to 3000.
PORT=3000

# Canonical public origin, used to build the loadstring and the MCP endpoint.
# Leave unset to derive it from the incoming request's forwarded host.
PUBLIC_BASE_URL=

# Salt for hashing client addresses in the audit trail.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# HMAC key for credential digests. Generate the same way as SESSION_SECRET.
# If either secret is unset, an ephemeral one is generated at boot and every
# session is invalidated on restart.
TOKEN_HASH_SECRET=

# Session lifetime in minutes (0-10080). Set to 0 for sessions that never expire
# on a timer and end only when terminated. With DATABASE_URL set, 0 means a
# session really does last until you terminate it, restarts included.
SESSION_TTL_MINUTES=0

# How long an owner-granted privileged capability lasts before expiring (1-120).
# Applies to Luau execution, executor globals and the remote spy.
PRIVILEGE_TTL_MINUTES=15

# Lifetime of the mutation grant (set_property, set_attribute, create_instance,
# destroy_instance, reparent_instance). 0 means it stands until the owner turns
# it off. Mutations write local client state only, which is a far smaller
# exposure than arbitrary Luau execution, so 0 is the default.
MUTATION_PRIVILEGE_TTL_MINUTES=0

# Maximum size of a single WebSocket frame, in bytes.
MAX_WS_PAYLOAD_BYTES=524288

# Upper bound on any single command timeout, in milliseconds.
MAX_COMMAND_TIMEOUT_MS=30000

# Upper bound on returned script source, in bytes.
MAX_SCRIPT_SOURCE_BYTES=262144

# Deployment kill switches for the privileged tool families.
# Setting either to false hides those tools regardless of any owner grant.
ENABLE_EXECUTE_LUAU_FEATURE=true
ENABLE_MUTATION_TOOLS_FEATURE=true
ENABLE_REMOTE_SPY_FEATURE=true

# Concurrent session ceiling.
MAX_SESSIONS=500

# Operator console credential. Leave EMPTY unless you run this deployment.
# When unset, the console does not exist: every one of its routes returns 404.
# When set, open it once at /admin?k=<this value> to obtain a session cookie.
# Minimum 24 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# How long an operator console sign-in lasts, in minutes.
ADMIN_SESSION_MINUTES=120

# Sessions a single client address may create per minute. Raise this only when a
# legitimate shared egress IP (or a test suite) needs it.
SESSION_CREATE_PER_MINUTE=12

# Postgres connection string. This is what makes sessions durable: the id,
# credential digests, privilege grants and capabilities are written through on
# every change and reloaded at boot, so a restart or a redeploy does not break
# the MCP endpoint your agent is configured against.
#
# Leave it unset and Clovyre still runs, but entirely in memory: every session
# dies with the process and every agent has to be reconfigured afterwards.
#
# Live connection state (WebSocket transport, pending commands, observation
# buffers, audit trail) is deliberately never persisted. It describes a process
# that no longer exists and rebuilds when the Roblox client reconnects.
DATABASE_URL=

# NOTE: deployment credentials (Render API keys, GitHub tokens) are never read
# by the application and must never appear in this file.
