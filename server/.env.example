# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/clovyre?schema=public"

# --- AI (OpenRouter, free models only) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional: comma-separated ladder override. Tried in order, first working wins.
OPENROUTER_MODELS=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Realtime (Pusher) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# --- Cron ---
CRON_SECRET=change-me
