# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Only for a split deployment (frontend and API on different domains).
# Leave unset when the API serves the frontend, which is the default.
CROSS_SITE_COOKIES=

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/clovyre?schema=public"

# --- AI (OpenRouter, free models only) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional: comma-separated ladder override. Tried in order, first working wins.
OPENROUTER_MODELS=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Realtime (Pusher) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# --- Proactive messages ---
# The API sweeps on this interval by itself, so no external cron is needed.
# Set to 0 to disable it and drive sweeps only via POST /api/cron/proactive.
PROACTIVE_INTERVAL_MINUTES=30

# Guards POST /api/cron/proactive. Only needed if you call that endpoint.
CRON_SECRET=change-me
