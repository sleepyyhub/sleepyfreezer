# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Only for a split deployment (frontend and API on different domains).
# Leave unset when the API serves the frontend, which is the default.
CROSS_SITE_COOKIES=

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/clovyre?schema=public"

# --- AI providers ---
# Set a key to enable a provider. The ladder spans providers in this order, so
# when one runs out of free allowance the next takes over. At least one required.
#
# AI_PROVIDERS=novita,openrouter,nvidia,groq   # optional: override the order

# Novita hosts Ling-3.0-flash at zero cost per token, and is the upstream that
# OpenRouter resells it from — going direct avoids OpenRouter's free-tier
# request cap. https://novita.ai
NOVITA_API_KEY=

# Free models here share one daily request cap per account. Raising it needs
# credits on the account. https://openrouter.ai
OPENROUTER_API_KEY=

# Fastest free option measured, ~14k requests/day, no card needed.
# https://console.groq.com
GROQ_API_KEY=

# ~1M tokens/day, very fast. The no-card free tier is being retired in favour
# of a credit-based one. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ~1,500 requests/day, no card. Google's terms allow free-tier prompts to be
# used for training — a poor fit for private chats. https://aistudio.google.com
GEMINI_API_KEY=

# https://console.mistral.ai
MISTRAL_API_KEY=

# Separate free allowance, but the least reliable measured here (503s, slow
# large models). https://build.nvidia.com
NVIDIA_API_KEY=

# Dev only: serve canned replies instead of calling a provider.
# MOCK_AI=true

# Free monthly credits with a plain HF token, no card. https://huggingface.co/settings/tokens
HF_TOKEN=

# Free with a GitHub account; allowance tied to your Copilot tier.
# A GitHub personal access token. https://github.com/marketplace/models
GITHUB_MODELS_TOKEN=

# Free daily allowance, no card. Needs the account id too — it goes in the URL.
# https://dash.cloudflare.com  (AI > Workers AI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# An aggregator with promotional free models. Measured hanging rather than
# answering on its free Kimi model. Note it sees every conversation in full.
# https://tokenrouter.com
TOKENROUTER_API_KEY=

# Optional per-provider model overrides, comma separated:
# NOVITA_MODELS=
# OPENROUTER_MODELS=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Realtime (Pusher) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# --- Proactive messages ---
# The API sweeps on this interval by itself, so no external cron is needed.
# Set to 0 to disable it and drive sweeps only via POST /api/cron/proactive.
PROACTIVE_INTERVAL_MINUTES=30

# Guards POST /api/cron/proactive. Only needed if you call that endpoint.
CRON_SECRET=change-me
