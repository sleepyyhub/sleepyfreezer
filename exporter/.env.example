# Genau einen von beiden setzen.

# Sauberer Weg: Bot-Token. Die Application muss im Server sein und dort
# Leserechte haben.
DISCORD_BOT_TOKEN=

# Schneller Weg: dein Account-Token. Kein Bot im Server nötig und die
# Search-API ist um Größenordnungen schneller — aber laut Discord-ToS
# Selfbotting, also auf eigenes Risiko.
DISCORD_USER_TOKEN=
